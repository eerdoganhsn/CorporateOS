# ---------------------------------------------------------------------------
# CorporateOS local development configuration
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. It is read by docker compose and, in the Development
# environment only, by the API (real environment variables take precedence).
# These values are for LOCAL DEVELOPMENT ONLY. Use a secret store in production.
# ---------------------------------------------------------------------------

# SQL Server container (min. 8 chars with upper, lower, digit and symbol)
MSSQL_SA_PASSWORD=Change_Me_Dev_Passw0rd!
MSSQL_PORT=1433

# Backend
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=CorporateOS;User Id=sa;Password=Change_Me_Dev_Passw0rd!;TrustServerCertificate=True;Encrypt=True
# Generate a random key, e.g.
#   PowerShell 7+:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash/openssl:   openssl rand -base64 48
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Jwt__Issuer=CorporateOS
Jwt__Audience=CorporateOS.Client
App__FrontendUrl=http://localhost:5173

# Mailpit (catches all outgoing mail; web UI at http://localhost:${MAILPIT_UI_PORT})
# Change the ports if they clash with other local services; keep Smtp__Port equal to MAILPIT_SMTP_PORT.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
Smtp__Host=localhost
Smtp__Port=1025
