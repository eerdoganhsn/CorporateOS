{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CorporateOS",
    "Audience": "CorporateOS.Client"
  },
  "AuthCookie": {
    "Name": "corporateos_rt",
    "Path": "/api/auth",
    "Secure": true
  },
  "App": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "Smtp": {
    "Host": "",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "no-reply@corporateos.local",
    "FromName": "CorporateOS"
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  },
  "ScheduledJobs": {
    "IntervalMinutes": 15
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/corporateos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
