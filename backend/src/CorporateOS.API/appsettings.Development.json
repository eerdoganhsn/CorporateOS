{
  "AuthCookie": {
    "Secure": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "AuthPermitLimit": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
